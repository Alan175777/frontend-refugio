---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
const { title = 'Refugio | Pet Lovers for Life' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Refugio de animales Pet Lovers for Life" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-800 antialiased">
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
