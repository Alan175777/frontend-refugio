---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---
<DashboardLayout title="Panel de animales | Refugio">
  <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end"><div><p class="font-semibold uppercase tracking-[.2em] text-green-800">Panel de administración</p><h1 class="mt-2 font-display text-5xl text-green-950">Nuestros animales</h1></div><a class="button-primary" href="/animals/new">+ Registrar animal</a></div>
  <div id="dashboard-message" class="mt-8 hidden rounded-xl px-4 py-3 text-sm"></div>
  <div class="mt-8 grid gap-4 sm:grid-cols-3"><div class="rounded-2xl bg-white p-5 shadow-card"><p class="text-sm text-slate-500">Total de animales</p><strong id="total-count" class="mt-2 block font-display text-4xl text-green-800">—</strong></div><div class="rounded-2xl bg-gold-400 p-5 shadow-card"><p class="text-sm text-green-950/70">Perros</p><strong id="dog-count" class="mt-2 block font-display text-4xl text-green-950">—</strong></div><div class="rounded-2xl bg-green-800 p-5 shadow-card"><p class="text-sm text-white/70">Gatos</p><strong id="cat-count" class="mt-2 block font-display text-4xl text-white">—</strong></div></div>
  <section class="mt-10 rounded-3xl bg-white p-5 shadow-card md:p-7"><div class="flex flex-col justify-between gap-4 md:flex-row md:items-center"><h2 class="font-display text-3xl text-green-950">Listado</h2><form id="filters" class="flex flex-wrap gap-2"><input name="nombre" class="rounded-full border border-slate-200 px-4 py-2 text-sm outline-none focus:border-green-800" placeholder="Buscar nombre" /><input name="raza" class="rounded-full border border-slate-200 px-4 py-2 text-sm outline-none focus:border-green-800" placeholder="Buscar raza" /><select name="tipoAnimal" class="rounded-full border border-slate-200 px-4 py-2 text-sm"><option value="">Todos</option><option>Perro</option><option>Gato</option></select><select name="sexo" class="rounded-full border border-slate-200 px-4 py-2 text-sm"><option value="">Sexo</option><option>Hembra</option><option>Macho</option></select><button class="button-secondary !px-4 !py-2" type="submit">Filtrar</button></form></div><div id="animals-list" class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3"><p class="text-sm text-slate-500">Cargando animales...</p></div></section>
  <script>
    import { apiRequest, ApiError } from '../lib/api';
    import { isAuthenticated } from '../lib/storage';
    import type { Animal } from '../types/animal';
    const list = document.querySelector<HTMLElement>('#animals-list'); const message = document.querySelector<HTMLElement>('#dashboard-message'); const filters = document.querySelector<HTMLFormElement>('#filters');
    if (!isAuthenticated()) window.location.href = '/login';
    async function load() { const params = new URLSearchParams(); if (filters) for (const [key, value] of new FormData(filters)) if (value) params.set(key, String(value)); try { const animals = await apiRequest<Animal[]>(`/animals${params.size ? `?${params}` : ''}`); render(animals); } catch (error) { if (message) { message.textContent = error instanceof ApiError ? error.message : 'No se pudo cargar el listado'; message.className = 'mt-8 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700'; } } }
    function render(animals: Animal[]) { document.querySelector('#total-count')!.textContent = String(animals.length); document.querySelector('#dog-count')!.textContent = String(animals.filter((a) => a.tipoAnimal === 'Perro').length); document.querySelector('#cat-count')!.textContent = String(animals.filter((a) => a.tipoAnimal === 'Gato').length); if (!list) return; list.innerHTML = animals.length ? animals.map((animal) => `<article class="rounded-2xl border border-slate-100 p-5"><div class="flex items-start justify-between"><span class="rounded-full ${animal.tipoAnimal === 'Perro' ? 'bg-gold-400' : 'bg-green-100'} px-3 py-1 text-xs font-bold text-green-950">${animal.tipoAnimal}</span><a class="text-sm font-bold text-green-800 hover:underline" href="/animals/edit?id=${animal.identificador}">Editar</a></div><h3 class="mt-5 font-display text-2xl text-green-950">${escapeHtml(animal.nombre)}</h3><p class="mt-1 text-sm text-slate-500">${escapeHtml(animal.raza)} · ${animal.edad} años</p><p class="mt-3 text-xs font-semibold uppercase tracking-wider text-green-800">${animal.sexo}</p></article>`).join('') : '<p class="text-sm text-slate-500">No hay animales que coincidan con los filtros.</p>'; }
    function escapeHtml(value: string) { return value.replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[char] ?? char)); }
    filters?.addEventListener('submit', (event) => { event.preventDefault(); load(); }); load();
  </script>
</DashboardLayout>
