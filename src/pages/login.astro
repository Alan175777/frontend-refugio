---
import PublicLayout from '../layouts/PublicLayout.astro';
import Alert from '../components/ui/Alert.astro';
---
<PublicLayout title="Iniciar sesión | Refugio">
  <section class="grid min-h-[calc(100vh-73px)] place-items-center px-5 py-12"><div class="w-full max-w-md rounded-3xl bg-white p-7 shadow-card md:p-10"><div class="mb-8 text-center"><span class="text-4xl">✦</span><h1 class="mt-3 font-display text-4xl text-green-950">Bienvenido</h1><p class="mt-2 text-sm text-slate-500">Ingresa para administrar el refugio</p></div><form id="login-form" class="space-y-5"><label class="field">Usuario<input name="usuario" autocomplete="username" placeholder="alan123" /></label><label class="field">Contraseña<input name="contrasena" type="password" autocomplete="current-password" placeholder="••••••••" /></label><Alert /><button class="button-primary w-full" type="submit">Iniciar sesión</button></form></div></section>
  <script>
    import { loginSchema } from '../schemas/auth.schema';
    import { apiRequest, ApiError } from '../lib/api';
    import { saveToken } from '../lib/storage';
    const form = document.querySelector<HTMLFormElement>('#login-form'); const message = document.querySelector<HTMLElement>('#form-message');
    form?.addEventListener('submit', async (event) => { event.preventDefault(); const parsed = loginSchema.safeParse(Object.fromEntries(new FormData(form))); if (!parsed.success) return show(parsed.error.issues[0]?.message ?? 'Revisa los datos'); const button = form.querySelector<HTMLButtonElement>('button'); if (button) { button.disabled = true; button.textContent = 'Validando...'; } try { const result = await apiRequest<{ token: string }>('/auth/login', { method: 'POST', body: JSON.stringify(parsed.data) }); saveToken(result.token); window.location.href = '/dashboard'; } catch (error) { show(error instanceof ApiError ? error.message : 'No se pudo iniciar sesión'); if (button) { button.disabled = false; button.textContent = 'Iniciar sesión'; } } });
    function show(text: string) { if (!message) return; message.textContent = text; message.className = 'rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700'; }
  </script>
</PublicLayout>
