---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import AnimalForm from '../../components/ui/AnimalForm.astro';
---
<DashboardLayout title="Editar animal | Refugio"><div class="mx-auto max-w-2xl"><p class="font-semibold uppercase tracking-[.2em] text-green-800">Administración</p><h1 class="mt-2 font-display text-5xl text-green-950">Editar animal</h1><p id="edit-loading" class="mt-3 mb-8 text-sm text-slate-500">Cargando información...</p><AnimalForm mode="edit" /></div>
  <script>
    import { apiRequest } from '../../lib/api'; import { isAuthenticated } from '../../lib/storage'; import type { Animal } from '../../types/animal';
    if (!isAuthenticated()) window.location.href = '/login';
    const id = new URLSearchParams(window.location.search).get('id'); const form = document.querySelector<HTMLFormElement>('#animal-form'); const loading = document.querySelector('#edit-loading');
    if (!id || !form) window.location.href = '/dashboard';
    else apiRequest<Animal[]>('/animals').then((animals) => { const animal = animals.find((item) => String(item.identificador) === id); if (!animal) { window.location.href = '/dashboard'; return; } form.dataset.id = id; for (const [name, value] of Object.entries(animal)) { const input = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null; if (input && name !== 'identificador' && name !== 'fechaIngreso') input.value = String(value); } loading?.remove(); }).catch(() => { window.location.href = '/dashboard'; });
  </script>
</DashboardLayout>
